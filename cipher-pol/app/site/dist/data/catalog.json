  "metric_definitions": {
    "R2": {
      "direction": "higher",
      "unit": "score",
      "definition": "One minus squared error relative to the mean-target baseline; can be negative."
    },
    "RMSE": {
      "direction": "lower",
      "unit": "dataset price units",
      "definition": "Square root of mean squared prediction error; emphasizes large errors."
    },
    "MAE": {
      "direction": "lower",
      "unit": "dataset price units",
      "definition": "Mean absolute prediction error."
    },
    "Accuracy": {
      "direction": "higher",
      "unit": "fraction",
      "definition": "Fraction of correctly classified observations."
    },
    "Precision": {
      "direction": "higher",
      "unit": "fraction",
      "definition": "Per-class precision averaged by true class support."
    },
    "Recall": {
      "direction": "higher",
      "unit": "fraction",
      "definition": "Per-class recall averaged by true class support."
    },
    "F1_weighted": {
      "direction": "higher",
      "unit": "fraction",
      "definition": "Per-class harmonic mean of precision and recall, averaged by true class support."
    },
    "ROC_AUC": {
      "direction": "higher",
      "unit": "score",
      "definition": "Probability-ranking discrimination; weighted one-versus-rest for multiclass."
    },
    "Silhouette Score": {
      "direction": "higher",
      "unit": "score",
      "definition": "Relative within-cluster cohesion versus nearest-cluster separation; range -1 to 1."
    },
    "Davies-Bouldin Index": {
      "direction": "lower",
      "unit": "index",
      "definition": "Average worst-case cluster scatter relative to separation."
    },
    "Calinski-Harabasz Index": {
      "direction": "higher",
      "unit": "index",
      "definition": "Between-cluster dispersion relative to within-cluster dispersion."
    }
  }
}